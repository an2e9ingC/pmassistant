#!/bin/bash
# PMA Docker Offline Installer
# Generated by docker-build.sh — {{BUILD_TIMESTAMP}}
# Run on the target server: sudo bash install.sh
set -e
set -o pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$SCRIPT_DIR"

# Redirect output to log file for troubleshooting
exec > >(tee -a "$SCRIPT_DIR/install.log") 2>&1
echo "Log file: $SCRIPT_DIR/install.log"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m'
IMAGE_FILE="pma-image.tar.gz"
IMAGE_TAG="{{IMAGE_TAG}}"

usage() {
    echo ""
    echo -e "${CYAN}PMA Docker Offline Installer — {{BUILD_VERSION}}${NC}"
    echo ""
    echo "在无外网的 Linux 服务器上通过 Docker 部署 PMA 系统。"
    echo ""
    echo -e "${CYAN}用法:${NC}"
    echo "  sudo bash install.sh         一键安装（推荐）"
    echo "  bash install.sh -h           显示此帮助"
    echo ""
    echo -e "${CYAN}功能:${NC}"
    echo "  1. 检查 Docker >= 20.10"
    echo "  2. 加载 Docker 镜像（$IMAGE_FILE）"
    echo "  3. 生成 .env 配置模板（如不存在）"
    echo "  4. 创建 data/ 数据目录"
    echo "  5. docker compose up -d 启动服务"
    echo "  6. 健康检查验证"
    echo ""
    echo -e "${CYAN}前置条件:${NC}"
    echo "  目标服务器需要: Docker >= 20.10"
    echo "  安装 Docker: curl -fsSL https://get.docker.com | sudo sh"
    echo ""
    echo -e "${CYAN}部署后配置:${NC}"
    echo "  1. 编辑 .env 填写禅道连接信息"
    echo "  2. docker compose restart"
    echo "  3. 或登录 PMA 管理后台在线配置"
    echo "  默认管理员: admin / admin123"
    echo ""
    echo -e "${CYAN}管理命令:${NC}"
    echo "  docker compose logs -f       实时查看日志"
    echo "  docker compose restart       重启服务"
    echo "  docker compose stop          停止服务"
    echo "  docker compose down          停止并删除容器"
    echo ""
    exit 0
}

# Handle help
if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
    usage
fi

echo ""
echo -e "${CYAN}══════════════════════════════════════════${NC}"
echo -e "${CYAN}  PMA Docker Offline Installer — {{BUILD_VERSION}}${NC}"
echo -e "${CYAN}══════════════════════════════════════════${NC}"
echo ""

# ── 1. Check Docker ──
echo -n "Checking Docker... "
if ! command -v docker &>/dev/null; then
    echo -e "${RED}NOT FOUND${NC}"
    echo ""
    echo -e "${RED}[ERROR] Docker is required but not installed.${NC}"
    echo "  Install Docker:"
    echo "    curl -fsSL https://get.docker.com | sudo sh"
    echo "  Or for offline install, download the Docker package for your OS."
    exit 1
fi

DOCKER_VER=$(docker version --format '{{.Server.Version}}' 2>/dev/null)
if [ -z "$DOCKER_VER" ]; then
    echo -e "${RED}NO PERMISSION${NC}"
    echo ""
    echo -e "${RED}[ERROR] Cannot access Docker daemon.${NC}"
    echo "  Make sure the Docker daemon is running and your user has permission:"
    echo "    sudo usermod -aG docker \$USER"
    echo "    newgrp docker"
    echo "  Or run this script with sudo:"
    echo "    sudo bash install.sh"
    exit 1
fi
echo -e "${GREEN}$DOCKER_VER${NC}"

# ── 2. Load Docker image ──
echo ""
echo "Loading Docker image..."
if [ ! -f "$SCRIPT_DIR/$IMAGE_FILE" ]; then
    echo -e "${RED}[ERROR] Image file not found: $SCRIPT_DIR/$IMAGE_FILE${NC}"
    exit 1
fi

echo -n "  Importing $IMAGE_FILE... "
docker load < "$SCRIPT_DIR/$IMAGE_FILE" 2>&1 | while IFS= read -r line; do
    echo "  $line"
done
echo -e "  ${GREEN}done${NC}"

# ── 3. Setup configuration ──
echo ""
if [ ! -f "$SCRIPT_DIR/.env" ]; then
    cp -n "$SCRIPT_DIR/.env.example" "$SCRIPT_DIR/.env" 2>/dev/null || true
    if [ -f "$SCRIPT_DIR/.env" ]; then
        echo -e "${GREEN}[OK]${NC} Created .env from template"
    else
        echo -e "${YELLOW}[WARN]${NC} Could not create .env (no template found)"
    fi
else
    echo -e "${GREEN}[OK]${NC} .env already exists (preserved)"
fi
echo "  Configure .env with your Zentao credentials, then restart:"
echo "    vi .env"
echo "    docker compose restart"

# ── 4. Create data directory ──
mkdir -p "$SCRIPT_DIR/data"
echo -e "${GREEN}[OK]${NC} Data directory: $SCRIPT_DIR/data/"

# ── 5. Start service ──
echo ""
echo "Starting PMA..."
docker compose up -d 2>&1 | while IFS= read -r line; do
    echo "  $line"
done

# ── 6. Health check ──
echo ""
echo -n "Waiting for service to be ready..."
for i in $(seq 1 30); do
    if curl -s http://localhost:8000/api/health > /dev/null 2>&1; then
        echo -e " ${GREEN}OK${NC}"
        break
    fi
    sleep 1
    echo -n "."
done

if ! curl -s http://localhost:8000/api/health > /dev/null 2>&1; then
    echo -e " ${YELLOW}TIMEOUT${NC}"
    echo "  Service may still be starting. Check logs:"
    echo "    docker compose logs -f"
fi

# ── 7. Done ──
HOST_IP=$(hostname -I 2>/dev/null | awk '{print $1}')
PORT=$(grep "^PMA_PORT=" "$SCRIPT_DIR/.env" 2>/dev/null | cut -d= -f2 | tr -d '"' | tr -d "'" || echo "8000")
PORT="${PORT:-8000}"

echo ""
echo -e "${GREEN}══════════════════════════════════════════${NC}"
echo -e "${GREEN}  Installation Complete${NC}"
echo -e "${GREEN}══════════════════════════════════════════${NC}"
echo ""
echo "  Access:       http://${HOST_IP}:${PORT}"
echo "  Login:        admin / admin123"
echo ""
echo "  Data:         $SCRIPT_DIR/data/"
echo "  Config:       $SCRIPT_DIR/.env"
echo "  Install log:  $SCRIPT_DIR/install.log"
echo ""
echo -e "${CYAN}  Management:${NC}"
echo "    Logs:       docker compose logs -f"
echo "    Restart:    docker compose restart"
echo "    Stop:       docker compose stop"
echo ""
echo -e "${YELLOW}  IMPORTANT:${NC}"
echo "    1. Edit .env to configure Zentao connection"
echo "    2. Change the admin password after first login"
echo ""
